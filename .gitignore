# Python virtualenv
.venv/

# Captured sensor data. These are run artifacts, not source -- a few minutes of
# 50 Hz streaming is megabytes of CSV that nobody needs in history.
logs/
runs/
*.csv

# Arduino build output
nicla_stream/build/

# Windows installer build. downloads/ is fetched from python.org, PyPI and GitHub and is
# pinned by packaging/hashes.txt rather than by being committed; dist/ is the staged tree
# and the installer built from it.
packaging/downloads/
packaging/dist/

# Python bytecode
__pycache__/
*.py[cod]

# Machine-local Claude Code settings (permissions etc.)
.claude/settings.local.json

# macOS
.DS_Store
